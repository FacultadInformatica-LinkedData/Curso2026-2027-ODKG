@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix hr:   <https://w3id.org/barcelona-heat-relief/ontology/HeatRelief#> .
@base <https://w3id.org/barcelona-heat-relief/mappings/areas-with-links#> .

# Districts and neighbourhoods, with their Wikidata items (csv/fonts-beure-2026-with-links.csv).
# Paths are relative to the HandsOn/Group08 directory, where Morph-KGC is run.
#
# The logical sources are SQL views over the CSV file (rml:query, executed by Morph-KGC with DuckDB):
# one row per district (10) and one per neighbourhood (73). The columns WIKIDATA-DISTRICTE and
# WIKIDATA-BARRI hold the QIDs found by reconciling NOM_DISTRICTE and NOM_BARRI in OpenRefine
# (lodrefine/fonts-beure-2026-with-links.json); they become owl:sameAs links to Wikidata.
#
# URIs of the individuals (feedback on HO4): the identifier is a slug of the name, readable and meaningful,
# never the numeric code of the source. slug = lower case, accents removed, the middle dot of "l·l" removed,
# every other run of characters that are not letters or digits replaced by a hyphen
# (e.g. "Sant Martí de Provençals" -> sant-marti-de-provencals, "l'Antiga Esquerra de l'Eixample" ->
# l-antiga-esquerra-de-l-eixample). Every mapping computes the slug of a neighbourhood in the same way,
# so the links between datasets keep pointing to the same URI.

<#District> a rr:TriplesMap ;
  rml:logicalSource [
    rml:query """
      SELECT DISTINCT NOM_DISTRICTE, "WIKIDATA-DISTRICTE" AS wikidata,
             lower(trim(regexp_replace(strip_accents(replace(NOM_DISTRICTE, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS district_slug
      FROM read_csv('csv/fonts-beure-2026-with-links.csv', header = true, all_varchar = true)
    """ ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "https://w3id.org/barcelona-heat-relief/resource/District/{district_slug}" ;
    rr:class hr:District
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "NOM_DISTRICTE" ; rr:language "ca" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rr:template "http://www.wikidata.org/entity/{wikidata}" ]
  ] .

<#Neighbourhood> a rr:TriplesMap ;
  rml:logicalSource [
    rml:query """
      SELECT DISTINCT NOM_BARRI, "WIKIDATA-BARRI" AS wikidata,
             lower(trim(regexp_replace(strip_accents(replace(NOM_BARRI, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS neighbourhood_slug,
             lower(trim(regexp_replace(strip_accents(replace(NOM_DISTRICTE, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS district_slug
      FROM read_csv('csv/fonts-beure-2026-with-links.csv', header = true, all_varchar = true)
    """ ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "https://w3id.org/barcelona-heat-relief/resource/Neighbourhood/{neighbourhood_slug}" ;
    rr:class hr:Neighbourhood
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "NOM_BARRI" ; rr:language "ca" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rr:template "http://www.wikidata.org/entity/{wikidata}" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:isPartOfDistrict ;
    rr:objectMap [ rr:template "https://w3id.org/barcelona-heat-relief/resource/District/{district_slug}" ]
  ] .
