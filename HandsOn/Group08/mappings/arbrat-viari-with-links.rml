@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix hr:   <https://w3id.org/barcelona-heat-relief/ontology/HeatRelief#> .
@base <https://w3id.org/barcelona-heat-relief/mappings/arbrat-viari-with-links#> .

# Street trees (D3, csv/arbrat-viari-with-links.csv) and their species, with the Wikidata links (HO5).
# The columns wikidata_sameas and wikidata_broadmatch hold the QIDs found by reconciling the species name in
# OpenRefine (lodrefine/arbrat-viari-with-links.json): owl:sameAs for a species, skos:broadMatch to the parent
# species or genus for a cultivar or a genus-only name. Only one of the two is filled in each row.
# Paths are relative to the HandsOn/Group08 directory, where Morph-KGC is run.
#
# The logical source of the trees is a SQL view over the CSV file (rml:query, executed by Morph-KGC with DuckDB):
#   - the placeholder street numbers 0 and 9999 at the end of adreca (", 0" and ", 9999") are removed,
#     so that those trees keep the street only;
#   - empty cells, which DuckDB reads as NULL, are turned into empty strings, so that Morph-KGC
#     generates no triple for them.
# The logical source of the species is a SQL view with one row per species (empty cells become empty strings).
#   - URIs: a tree is named by the slug of its species and its code (pinus-pinea-0000423ar), a species by the
#     slug of its scientific name (pinus-pinea): the 288 species ids have 288 different scientific names;
#   - label of a tree: scientific name of the species followed by the tree code;
#   - hr:plantingDate: the source gives only the day, so "T00:00:00" is appended (xsd:dateTime, see the ontology);
#   - the species are read from the same file: every species id has a single scientific name and a single
#     set of common names, so each species is described once;
#   - the tree 0345745AR has no neighbourhood in the source, so it has no hr:isLocatedInNeighbourhood link.
#
# URIs of the individuals (feedback on HO4): the identifier is a slug of the name, readable and meaningful,
# never the numeric code of the source. slug = lower case, accents removed, the middle dot of "l·l" removed,
# every other run of characters that are not letters or digits replaced by a hyphen
# (e.g. "Sant Martí de Provençals" -> sant-marti-de-provencals, "l'Antiga Esquerra de l'Eixample" ->
# l-antiga-esquerra-de-l-eixample). Every mapping computes the slug of a neighbourhood in the same way,
# so the links between datasets keep pointing to the same URI.

#################################################################
#    Street trees
#################################################################

<#StreetTree> a rr:TriplesMap ;
  rml:logicalSource [
    rml:query """
      SELECT coalesce(COLUMNS(*), '') FROM (
      SELECT * REPLACE (regexp_replace(adreca, ', (0|9999)$', '') AS adreca),
        lower(trim(regexp_replace(strip_accents(replace(cat_nom_cientific || ' ' || codi, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS tree_slug,
        lower(trim(regexp_replace(strip_accents(replace(cat_nom_cientific, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS species_slug,
        lower(trim(regexp_replace(strip_accents(replace(nom_barri, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS neighbourhood_slug
      FROM read_csv('csv/arbrat-viari-with-links.csv', header = true, all_varchar = true)
      )
    """ ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "https://w3id.org/barcelona-heat-relief/resource/StreetTree/{tree_slug}" ;
    rr:class hr:StreetTree
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "{cat_nom_cientific} {codi}" ; rr:termType rr:Literal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:hasSpecies ;
    rr:objectMap [ rr:template "https://w3id.org/barcelona-heat-relief/resource/TreeSpecies/{species_slug}" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:treeCategory ;
    rr:objectMap [ rml:reference "categoria_arbrat" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:irrigationType ;
    rr:objectMap [ rml:reference "tipus_reg" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:irrigationWaterType ;
    rr:objectMap [ rml:reference "tipus_aigua 1" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:irrigationWaterType ;
    rr:objectMap [ rml:reference "tipus_aigua 2" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:greenSpace ;
    rr:objectMap [ rml:reference "espai_verd" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:streetAddress ;
    rr:objectMap [ rml:reference "adreca" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:etrs89X ;
    rr:objectMap [ rml:reference "x_etrs89" ; rr:datatype xsd:decimal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:etrs89Y ;
    rr:objectMap [ rml:reference "y_etrs89" ; rr:datatype xsd:decimal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate geo:lat ;
    rr:objectMap [ rml:reference "latitud" ; rr:datatype xsd:decimal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate geo:long ;
    rr:objectMap [ rml:reference "longitud" ; rr:datatype xsd:decimal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:plantingDate ;
    rr:objectMap [ rr:template "{data_plantacio}T00:00:00" ; rr:termType rr:Literal ; rr:datatype xsd:dateTime ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:isLocatedInNeighbourhood ;
    rr:objectMap [ rr:template "https://w3id.org/barcelona-heat-relief/resource/Neighbourhood/{neighbourhood_slug}" ]
  ] .

#################################################################
#    Tree species
#################################################################

<#TreeSpecies> a rr:TriplesMap ;
  rml:logicalSource [
    rml:query """
      SELECT coalesce(COLUMNS(*), '') FROM (
      SELECT DISTINCT cat_nom_cientific, "cat_nom_castella 1", "cat_nom_castella 2", "cat_nom_catala 1", "cat_nom_catala 2", wikidata_sameas, wikidata_broadmatch,
        lower(trim(regexp_replace(strip_accents(replace(cat_nom_cientific, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS species_slug
      FROM read_csv('csv/arbrat-viari-with-links.csv', header = true, all_varchar = true)
      )
    """ ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "https://w3id.org/barcelona-heat-relief/resource/TreeSpecies/{species_slug}" ;
    rr:class hr:TreeSpecies
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "cat_nom_cientific" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:scientificName ;
    rr:objectMap [ rml:reference "cat_nom_cientific" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:spanishName ;
    rr:objectMap [ rml:reference "cat_nom_castella 1" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:spanishName ;
    rr:objectMap [ rml:reference "cat_nom_castella 2" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:catalanName ;
    rr:objectMap [ rml:reference "cat_nom_catala 1" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:catalanName ;
    rr:objectMap [ rml:reference "cat_nom_catala 2" ; rr:datatype xsd:string ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rr:template "http://www.wikidata.org/entity/{wikidata_sameas}" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate skos:broadMatch ;
    rr:objectMap [ rr:template "http://www.wikidata.org/entity/{wikidata_broadmatch}" ]
  ] .
