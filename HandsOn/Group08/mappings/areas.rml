@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hr:   <https://w3id.org/barcelona-heat-relief/ontology/HeatRelief#> .
@base <https://w3id.org/barcelona-heat-relief/mappings/areas#> .

# Neighbourhoods and districts of Barcelona.
# Paths are relative to the HandsOn/Group08 directory, where Morph-KGC is run.
#
# The areas are taken from the climate shelters (D1) and the drinking fountains (D2). After the
# OpenRefine cleaning (hands-on 3) both files use the official codes and names, and together with the
# street trees (D3) they contain the same 73 neighbourhoods and 10 districts, so every
# hr:isLocatedInNeighbourhood link of the three datasets points to a neighbourhood described here.
#
# URIs of the individuals (feedback on HO4): the identifier is a slug of the name, readable and meaningful,
# never the numeric code of the source. slug = lower case, accents removed, the middle dot of "l·l" removed,
# every other run of characters that are not letters or digits replaced by a hyphen
# (e.g. "Sant Martí de Provençals" -> sant-marti-de-provencals, "l'Antiga Esquerra de l'Eixample" ->
# l-antiga-esquerra-de-l-eixample). Every mapping computes the slug of a neighbourhood in the same way,
# so the links between datasets keep pointing to the same URI.

<#Neighbourhood> a rr:TriplesMap ;
  rml:logicalSource [
    rml:query """
      SELECT neighbourhood_name,
             lower(trim(regexp_replace(strip_accents(replace(neighbourhood_name, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS neighbourhood_slug,
             lower(trim(regexp_replace(strip_accents(replace(district_name, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS district_slug
      FROM (
        SELECT DISTINCT addresses_neighborhood_name AS neighbourhood_name,
                        addresses_district_name AS district_name
        FROM read_csv('csv/xarxa-refugis-climatics-updated.csv', header = true, all_varchar = true)
        UNION
        SELECT DISTINCT NOM_BARRI, NOM_DISTRICTE
        FROM read_csv('csv/fonts-beure-2026-updated.csv', header = true, all_varchar = true)
      )
    """ ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "https://w3id.org/barcelona-heat-relief/resource/Neighbourhood/{neighbourhood_slug}" ;
    rr:class hr:Neighbourhood
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "neighbourhood_name" ; rr:language "ca" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate hr:isPartOfDistrict ;
    rr:objectMap [ rr:template "https://w3id.org/barcelona-heat-relief/resource/District/{district_slug}" ]
  ] .

<#District> a rr:TriplesMap ;
  rml:logicalSource [
    rml:query """
      SELECT district_name, lower(trim(regexp_replace(strip_accents(replace(district_name, '·', '')), '[^A-Za-z0-9]+', '-', 'g'), '-')) AS district_slug
      FROM (
        SELECT DISTINCT addresses_district_name AS district_name
        FROM read_csv('csv/xarxa-refugis-climatics-updated.csv', header = true, all_varchar = true)
        UNION
        SELECT DISTINCT NOM_DISTRICTE
        FROM read_csv('csv/fonts-beure-2026-updated.csv', header = true, all_varchar = true)
      )
    """ ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "https://w3id.org/barcelona-heat-relief/resource/District/{district_slug}" ;
    rr:class hr:District
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "district_name" ; rr:language "ca" ]
  ] .
