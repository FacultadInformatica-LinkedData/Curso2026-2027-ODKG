@prefix aq: <https://w3id.org/valencia-airquality/ontology/airquality#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Main shape.
aq:ObservationShape
    a sh:NodeShape ;
    sh:targetClass aq:Observation ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Each observation must have an rdfs:label."@en
    ] ;

    sh:property [
        sh:path aq:hasStation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Each observation must be linked to a station via an URI."@en
    ] ;

    sh:property [
        sh:path aq:observedProperty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Each observation must indicate an observable property via an URI."@en
    ] ;

    sh:property [
        sh:path aq:resultTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Each observation must contain a date and time with the format xsd:dateTime."@en
    ] ;

    sh:property [
        sh:path aq:resultValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:float ]
        ) ;
        sh:message "Each observation must have a numerical value."@en
    ] .
