@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix pe:     <http://smartcity.chicago.es/ontology/ParkExplorer#> .
@base           <http://smartcity.chicago.es/mappings/park-art-with-links#> .

#################################################################
# Chicago Park District Park Art (fixed version of mappings/park-art-with-links.rml)
# Source: csv/CPD_Park_Art_20261001-with-links-fixed.csv
#
# Individuals (see analysis.html, section 3.2). Every identifier is a readable
# slug built from names in OpenRefine (fixed_json/CPD_Park_Art_20261001-with-links-fixed.json):
#   Park        http://smartcity.chicago.es/resource/ChicagoPark/{PARK_ID}
#   Artwork     http://smartcity.chicago.es/resource/Artwork/{ARTWORK_ID}
#   Coordinates http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_{ARTWORK_ID}
#   Artist      http://smartcity.chicago.es/resource/Artist/{ARTIST_ID}
#   Owner       http://smartcity.chicago.es/resource/Owner/{OWNER_ID}
#   e.g. ChicagoPark/Indian_Boundary, Artwork/Indian_Boundary_River_Suite,
#        GeoCoordinates/Artwork_Indian_Boundary_River_Suite, Artist/Phil_Schuster
#
# Links to other datasets (Hands-on 5):
#   Park   owl:sameAs Wikidata item (WIKIDATA_PARK_URI)
#   Artist owl:sameAs Wikidata item (WIKIDATA_ARTIST_URI)
#################################################################

<#Park> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/CPD_Park_Art_20261001-with-links-fixed.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "http://smartcity.chicago.es/resource/ChicagoPark/{PARK_ID}" ;
    rr:class pe:ChicagoPark
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "PARK_NAME" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:parkName ;
    rr:objectMap [ rml:reference "PARK_NAME" ]
  ] ;

  # Link to Wikidata (column added by reconciliation in OpenRefine).
  # Parks that could not be reconciled have an empty cell: no triple.
  # The column holds a full URI, so it is read with rml:reference + rr:IRI
  # (an rr:template would percent-encode the "http://" part).
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rml:reference "WIKIDATA_PARK_URI" ; rr:termType rr:IRI ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:parkNumber ;
    rr:objectMap [ rml:reference "PARK_NO" ; rr:datatype xsd:integer ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:hasArtwork ;
    rr:objectMap [ rr:parentTriplesMap <#Artwork> ]
  ] .


<#Artwork> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/CPD_Park_Art_20261001-with-links-fixed.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "http://smartcity.chicago.es/resource/Artwork/{ARTWORK_ID}" ;
    rr:class pe:Artwork
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "ARTWORK_NAME" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:artworkName ;
    rr:objectMap [ rml:reference "ARTWORK_NAME" ]
  ] ;

  # OFFICIAL_NAME is only filled when it differs from ARTWORK_NAME (60 artworks).
  rr:predicateObjectMap [
    rr:predicate pe:officialName ;
    rr:objectMap [ rml:reference "OFFICIAL_NAME" ]
  ] ;

  # GIS_OBJECT_ID is empty for 38 artworks (placeholder 0 removed in OpenRefine).
  rr:predicateObjectMap [
    rr:predicate pe:artworkGisObjectId ;
    rr:objectMap [ rml:reference "GIS_OBJECT_ID" ; rr:datatype xsd:integer ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:madeBy ;
    rr:objectMap [ rr:parentTriplesMap <#Artist> ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:owner ;
    rr:objectMap [ rr:parentTriplesMap <#Owner> ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:geo ;
    rr:objectMap [ rr:parentTriplesMap <#ArtworkGeo> ]
  ] .


<#ArtworkGeo> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/CPD_Park_Art_20261001-with-links-fixed.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_{ARTWORK_ID}" ;
    rr:class schema:GeoCoordinates
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:template "Coordinates of {ARTWORK_NAME} in {PARK_NAME}" ; rr:termType rr:Literal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:latitude ;
    rr:objectMap [ rml:reference "LATITUDE" ; rr:datatype xsd:decimal ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate schema:longitude ;
    rr:objectMap [ rml:reference "LONGITUDE" ; rr:datatype xsd:decimal ]
  ] .


<#Artist> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/CPD_Park_Art_20261001-with-links-fixed.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "http://smartcity.chicago.es/resource/Artist/{ARTIST_ID}" ;
    rr:class pe:Artist
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "ARTIST_NAME" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:artistName ;
    rr:objectMap [ rml:reference "ARTIST_NAME" ]
  ] ;

  # Link to Wikidata (column added by reconciliation in OpenRefine).
  # Artists that could not be reconciled have an empty cell: no triple.
  rr:predicateObjectMap [
    rr:predicate owl:sameAs ;
    rr:objectMap [ rml:reference "WIKIDATA_ARTIST_URI" ; rr:termType rr:IRI ]
  ] .


<#Owner> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "csv/CPD_Park_Art_20261001-with-links-fixed.csv" ;
    rml:referenceFormulation ql:CSV
  ] ;

  rr:subjectMap [
    rr:template "http://smartcity.chicago.es/resource/Owner/{OWNER_ID}" ;
    rr:class pe:Owner
  ] ;

  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "OWNER_NAME" ]
  ] ;

  rr:predicateObjectMap [
    rr:predicate pe:ownerName ;
    rr:objectMap [ rml:reference "OWNER_NAME" ]
  ] .
