@prefix : <http://smartcity.chicago.es/ontology/ParkExplorer#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Example 1: Indian Boundary Park (Park No. 165)
# One artwork, one artist, one owner
#################################################################

<http://smartcity.chicago.es/resource/ChicagoPark/Indian_Boundary> a :ChicagoPark ;
    :parkName "INDIAN BOUNDARY" ;
    :parkNumber 165 ;
    :hasArtwork <http://smartcity.chicago.es/resource/Artwork/Indian_Boundary_River_Suite> .

### Artwork: River Suite (ARTWORK_ID = park + artwork name) ###
<http://smartcity.chicago.es/resource/Artwork/Indian_Boundary_River_Suite> a :Artwork ;
    :artworkName "River Suite" ;
    :artworkGisObjectId 5856 ;
    :owner <http://smartcity.chicago.es/resource/Owner/Chicago_Park_District> ;
    :madeBy <http://smartcity.chicago.es/resource/Artist/Phil_Schuster> ;
    schema:geo <http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_Indian_Boundary_River_Suite> .

<http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_Indian_Boundary_River_Suite> a schema:GeoCoordinates ;
    schema:latitude "42.0101658765"^^xsd:decimal ;
    schema:longitude "-87.6938203714"^^xsd:decimal .

### Artist: Phil Schuster (ARTIST_ID = slug of ARTIST_NAME) ###
<http://smartcity.chicago.es/resource/Artist/Phil_Schuster> a :Artist ;
    :artistName "Phil Schuster" .

### Owner: Chicago Park District (OWNER_ID = slug of OWNER_NAME) ###
<http://smartcity.chicago.es/resource/Owner/Chicago_Park_District> a :Owner ;
    :ownerName "Chicago Park District" .


#################################################################
# Example 2: Lincoln Park (Park No. 100)
# An artwork with an official name, created by a firm
#################################################################

<http://smartcity.chicago.es/resource/ChicagoPark/Lincoln_Abraham> a :ChicagoPark ;
    :parkName "LINCOLN (ABRAHAM)" ;
    :parkNumber 100 ;
    :hasArtwork <http://smartcity.chicago.es/resource/Artwork/Lincoln_Abraham_City_Hall_Relic_Finial> .

### Artwork: City Hall Relic (Finial) (ARTWORK_ID = park + artwork name) ###
<http://smartcity.chicago.es/resource/Artwork/Lincoln_Abraham_City_Hall_Relic_Finial> a :Artwork ;
    :artworkName "City Hall Relic (Finial)" ;
    :officialName "City Hall Relic" ;
    :artworkGisObjectId 1316 ;
    :owner <http://smartcity.chicago.es/resource/Owner/Chicago_Park_District> ;
    :madeBy <http://smartcity.chicago.es/resource/Artist/Jenney_Loring> ;
    schema:geo <http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_Lincoln_Abraham_City_Hall_Relic_Finial> .

<http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_Lincoln_Abraham_City_Hall_Relic_Finial> a schema:GeoCoordinates ;
    schema:latitude "41.9188563043"^^xsd:decimal ;
    schema:longitude "-87.6361069978"^^xsd:decimal .

### Artist: the architecture firm Jenney & Loring (kept as one creator) ###
<http://smartcity.chicago.es/resource/Artist/Jenney_Loring> a :Artist ;
    :artistName "Jenney & Loring" .


#################################################################
# Example 3: Jane Addams Memorial Park (Park No. 1224)
# An artwork with two owners (one :owner triple each)
#################################################################

<http://smartcity.chicago.es/resource/ChicagoPark/Addams_Jane_Meml> a :ChicagoPark ;
    :parkName "ADDAMS (JANE) MEML." ;
    :parkNumber 1224 ;
    :hasArtwork <http://smartcity.chicago.es/resource/Artwork/Addams_Jane_Meml_Jane_Addams_Mosaic> .

### Artwork: Jane Addams Mosaic (ARTWORK_ID = park + artwork name) ###
<http://smartcity.chicago.es/resource/Artwork/Addams_Jane_Meml_Jane_Addams_Mosaic> a :Artwork ;
    :artworkName "Jane Addams Mosaic" ;
    :artworkGisObjectId 6169 ;
    :owner <http://smartcity.chicago.es/resource/Owner/City_of_Chicago>,
           <http://smartcity.chicago.es/resource/Owner/Chicago_Park_District> ;
    :madeBy <http://smartcity.chicago.es/resource/Artist/Mirtes_Zwierzynski> ;
    schema:geo <http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_Addams_Jane_Meml_Jane_Addams_Mosaic> .

<http://smartcity.chicago.es/resource/GeoCoordinates/Artwork_Addams_Jane_Meml_Jane_Addams_Mosaic> a schema:GeoCoordinates ;
    schema:latitude "41.8927674856"^^xsd:decimal ;
    schema:longitude "-87.6137508666"^^xsd:decimal .

<http://smartcity.chicago.es/resource/Artist/Mirtes_Zwierzynski> a :Artist ;
    :artistName "Mirtes Zwierzynski" .

<http://smartcity.chicago.es/resource/Owner/City_of_Chicago> a :Owner ;
    :ownerName "City of Chicago" .


#################################################################
# Example 4: Alexander Hamilton Park (Park No. 9)
# A facility (URI built from the park and facility names, not from a record number)
#################################################################

<http://smartcity.chicago.es/resource/ChicagoPark/Hamilton_Alexander> a :ChicagoPark ;
    :parkName "HAMILTON (ALEXANDER)" ;
    :parkNumber 9 ;
    :hasFacility <http://smartcity.chicago.es/resource/Facility/Hamilton_Alexander_Cultural_Center> .

### Facility: Cultural Center in Hamilton Park (FACILITY_ID = park + facility name) ###
<http://smartcity.chicago.es/resource/Facility/Hamilton_Alexander_Cultural_Center> a :Facility ;
    :facilityName "CULTURAL CENTER" ;
    :facilityType "SPECIAL" ;
    :facilityGisObjectId 2494 ;
    schema:geo <http://smartcity.chicago.es/resource/GeoCoordinates/Facility_Hamilton_Alexander_Cultural_Center> .

<http://smartcity.chicago.es/resource/GeoCoordinates/Facility_Hamilton_Alexander_Cultural_Center> a schema:GeoCoordinates ;
    schema:latitude "41.76299921"^^xsd:decimal ;
    schema:longitude "-87.63769763"^^xsd:decimal .
