
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ao: <http://group01.opendata.upm.es/ontology/accidents#> .
@prefix map: <http://group01.opendata.upm.es/mappings/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .

# Mapping for traffic accidents
map:AccidentMap a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/US_Accidents_New_York-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://group01.opendata.upm.es/resource/accidents/{ID}" ;
        rr:class ao:TrafficAccident
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:severity ;
        rr:objectMap [
            rml:reference "Severity" ;
            rr:datatype xsd:integer
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:startTime ;
        rr:objectMap [
            rml:reference "Start_Time" ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:endTime ;
        rr:objectMap [
            rml:reference "End_Time" ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:latitude ;
        rr:objectMap [
            rml:reference "Start_Lat" ;
            rr:datatype xsd:decimal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:longitude ;
        rr:objectMap [
            rml:reference "Start_Lng" ;
            rr:datatype xsd:decimal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:description ;
        rr:objectMap [
            rml:reference "Description" ;
            rr:datatype xsd:string
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:hasTrafficSignal ;
        rr:objectMap [
            rml:reference "Traffic_Signal" ;
            rr:datatype xsd:boolean
        ]
    ] ;

    # Link accidents to their streets
    rr:predicateObjectMap [
        rr:predicate ao:locatedOn ;
        rr:objectMap [
            rr:parentTriplesMap map:StreetMap ;
            rr:joinCondition [
                rr:child "Street_Slug" ;
                rr:parent "Street_Slug"
            ]
        ]
    ] ;

    # Link accidents to New York City
    rr:predicateObjectMap [
        rr:predicate schema:location ;
        rr:objectMap [
            rr:constant
              <http://group01.opendata.upm.es/resource/cities/New-York>
        ]
    ] .

# Mapping for streets
map:StreetMap a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/US_Accidents_New_York-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://group01.opendata.upm.es/resource/streets/{Street_Slug}" ;
        rr:class ao:Street
    ] ;

    rr:predicateObjectMap [
        rr:predicate ao:streetName ;
        rr:objectMap [
            rml:reference "Street" ;
            rr:datatype xsd:string
        ]
    ] ;

    # Link streets to Wikidata
    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rml:reference "Wikidata_URI" ;
            rr:termType rr:IRI
        ]
    ] .

# Mapping for New York City
map:CityMap a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/US_Accidents_New_York-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:constant
          <http://group01.opendata.upm.es/resource/cities/New-York> ;
        rr:class schema:City
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [
            rml:reference "City"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rml:reference "City_Wikidata_URI" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:containedInPlace ;
        rr:objectMap [
            rr:constant
              <http://group01.opendata.upm.es/resource/states/NY>
        ]
    ] .

# Mapping for New York State
map:StateMap a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/US_Accidents_New_York-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:constant
          <http://group01.opendata.upm.es/resource/states/NY> ;
        rr:class schema:AdministrativeArea
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [
            rml:reference "State"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rml:reference "State_Wikidata_URI" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:containedInPlace ;
        rr:objectMap [
            rr:constant
              <http://group01.opendata.upm.es/resource/countries/US>
        ]
    ] .

# Mapping for United States
map:CountryMap a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/US_Accidents_New_York-with-links.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:constant
          <http://group01.opendata.upm.es/resource/countries/US> ;
        rr:class schema:Country
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [
            rml:reference "Country"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate owl:sameAs ;
        rr:objectMap [
            rml:reference "Country_Wikidata_URI" ;
            rr:termType rr:IRI
        ]
    ] .
