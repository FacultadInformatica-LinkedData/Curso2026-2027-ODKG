@prefix am: <https://w3id.org/active-madrid/ontology#> .
@prefix map: <http://mapping.example.com/> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix schema1: <http://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

map:map_triplesmapClosedClasses_000 a rr:TriplesMap ;
    rdfs:label "triplesmapClosedClasses" ;
    rml:logicalSource map:source_008 ;
    rr:predicateObjectMap map:pom_032,
        map:pom_033,
        map:pom_034,
        map:pom_035,
        map:pom_036,
        map:pom_037,
        map:pom_038,
        map:pom_039 ;
    rr:subjectMap map:s_008 .

map:map_triplesmapTimeIntervals_001 a rr:TriplesMap ;
    rdfs:label "triplesmapTimeIntervals" ;
    rml:logicalSource map:source_009 ;
    rr:predicateObjectMap map:pom_040,
        map:pom_041,
        map:pom_042 ;
    rr:subjectMap map:s_009 .

map:map_triplesmapSportActivity_001 a rr:TriplesMap ;
    rdfs:label "triplesmapSportActivity" ;
    rml:logicalSource map:source_005 ;
    rr:predicateObjectMap map:pom_019,
        map:pom_020 ;
    rr:subjectMap map:s_005 .

map:jc_001 rr:child "Centro deportivo" ;
    rr:parent "NOMBRE" .

map:map_triplesmapSportsFacility_000 a rr:TriplesMap ;
    rdfs:label "triplesmapSportsFacility" ;
    rml:logicalSource map:source_000 ;
    rr:subjectMap map:s_000 .

map:om_019 a rr:ObjectMap ;
    rr:constant am:SportActivity ;
    rr:termType rr:IRI .

map:om_020 a rr:ObjectMap ;
    rml:reference "Actividad" ;
    rr:datatype xsd:string ;
    rr:termType rr:Literal .

map:om_031 a rr:ObjectMap ;
    rr:constant am:SportsClass ;
    rr:termType rr:IRI .

map:om_032 a rr:ObjectMap ;
    rml:reference "Clase" ;
    rr:datatype xsd:string ;
    rr:termType rr:Literal .

map:om_033 a rr:ObjectMap ;
    rml:reference "Plazas" ;
    rr:datatype xsd:nonNegativeInteger ;
    rr:termType rr:Literal .

map:om_034 a rr:ObjectMap ;
    rml:reference "Ocupadas" ;
    rr:datatype xsd:nonNegativeInteger ;
    rr:termType rr:Literal .

map:om_035 a rr:ObjectMap ;
    rml:reference "Libres" ;
    rr:datatype xsd:nonNegativeInteger ;
    rr:termType rr:Literal .

map:om_036 a rr:ObjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportActivity/{Actividad}" ;
    rr:termType rr:IRI .

map:om_038 a rr:ObjectMap ;
    rr:joinCondition map:jc_001 ;
    rr:parentTriplesMap map:map_triplesmapSportsFacility_000 .

map:om_039 a rr:ObjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/TimeInterval/{Hora inicial}-{Hora final}" ;
    rr:termType rr:IRI .

map:om_040 a rr:ObjectMap ;
    rr:constant time:Interval ;
    rr:termType rr:IRI .

map:om_041 a rr:ObjectMap ;
    rml:reference "Hora inicial" ;
    rr:datatype xsd:time ;
    rr:termType rr:Literal .

map:om_042 a rr:ObjectMap ;
    rml:reference "Hora final" ;
    rr:datatype xsd:time ;
    rr:termType rr:Literal .

map:pm_019 a rr:PredicateMap ;
    rr:constant rdf:type .

map:pm_020 a rr:PredicateMap ;
    rr:constant schema1:name .

map:pm_032 a rr:PredicateMap ;
    rr:constant rdf:type .

map:pm_033 a rr:PredicateMap ;
    rr:constant schema1:name .

map:pm_034 a rr:PredicateMap ;
    rr:constant am:offeredPlaces .

map:pm_035 a rr:PredicateMap ;
    rr:constant am:occupiedPlaces .

map:pm_036 a rr:PredicateMap ;
    rr:constant am:availablePlaces .

map:pm_037 a rr:PredicateMap ;
    rr:constant am:hasActivity .

map:pm_038 a rr:PredicateMap ;
    rr:constant am:takesPlaceAt .

map:pm_039 a rr:PredicateMap ;
    rr:constant time:hasTime .

map:pm_040 a rr:PredicateMap ;
    rr:constant rdf:type .

map:pm_041 a rr:PredicateMap ;
    rr:constant time:hasBeginning .

map:pm_042 a rr:PredicateMap ;
    rr:constant time:hasEnd .

map:pom_019 a rr:PredicateObjectMap ;
    rr:objectMap map:om_019 ;
    rr:predicateMap map:pm_019 .

map:pom_020 a rr:PredicateObjectMap ;
    rr:objectMap map:om_020 ;
    rr:predicateMap map:pm_020 .

map:pom_032 a rr:PredicateObjectMap ;
    rr:objectMap map:om_031 ;
    rr:predicateMap map:pm_032 .

map:pom_033 a rr:PredicateObjectMap ;
    rr:objectMap map:om_032 ;
    rr:predicateMap map:pm_033 .

map:pom_034 a rr:PredicateObjectMap ;
    rr:objectMap map:om_033 ;
    rr:predicateMap map:pm_034 .

map:pom_035 a rr:PredicateObjectMap ;
    rr:objectMap map:om_034 ;
    rr:predicateMap map:pm_035 .

map:pom_036 a rr:PredicateObjectMap ;
    rr:objectMap map:om_035 ;
    rr:predicateMap map:pm_036 .

map:pom_037 a rr:PredicateObjectMap ;
    rr:objectMap map:om_036 ;
    rr:predicateMap map:pm_037 .

map:pom_038 a rr:PredicateObjectMap ;
    rr:objectMap map:om_038 ;
    rr:predicateMap map:pm_038 .

map:pom_039 a rr:PredicateObjectMap ;
    rr:objectMap map:om_039 ;
    rr:predicateMap map:pm_039 .

map:pom_040 a rr:PredicateObjectMap ;
    rr:objectMap map:om_040 ;
    rr:predicateMap map:pm_040 .

map:pom_041 a rr:PredicateObjectMap ;
    rr:objectMap map:om_041 ;
    rr:predicateMap map:pm_041 .

map:pom_042 a rr:PredicateObjectMap ;
    rr:objectMap map:om_042 ;
    rr:predicateMap map:pm_042 .

map:s_000 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportsFacility/{PK}" .

map:s_005 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportActivity/{Actividad}" .

map:s_008 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportsClass/CLOSED_{Centro deportivo}_{Clase}_{Año}_{Mes}" .

map:s_009 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/TimeInterval/{Hora inicial}-{Hora final}" .

map:source_000 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "sports_centers_info-updated.csv" .

map:source_005 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "closed_classes-updated.csv" .

map:source_008 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "closed_classes-updated.csv" .

map:source_009 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "closed_classes-updated.csv" .

