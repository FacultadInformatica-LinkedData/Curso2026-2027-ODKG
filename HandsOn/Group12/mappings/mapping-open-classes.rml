@prefix am: <https://w3id.org/active-madrid/ontology#> .
@prefix map: <http://mapping.example.com/> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix schema1: <http://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

map:map_triplesmapOpenClasses_000 a rr:TriplesMap ;
    rdfs:label "triplesmapOpenClasses" ;
    rml:logicalSource map:source_007 ;
    rr:predicateObjectMap map:pom_024,
        map:pom_025,
        map:pom_026,
        map:pom_027,
        map:pom_028,
        map:pom_029,
        map:pom_030,
        map:pom_031 ;
    rr:subjectMap map:s_007 .

map:map_triplesmapSportActivity_000 a rr:TriplesMap ;
    rdfs:label "triplesmapSportActivity" ;
    rml:logicalSource map:source_004 ;
    rr:predicateObjectMap map:pom_017,
        map:pom_018 ;
    rr:subjectMap map:s_004 .

map:map_triplesmapTimeIntervals_000 a rr:TriplesMap ;
    rdfs:label "triplesmapTimeIntervals" ;
    rml:logicalSource map:source_006 ;
    rr:predicateObjectMap map:pom_021,
        map:pom_022,
        map:pom_023 ;
    rr:subjectMap map:s_006 .

map:jc_000 rr:child "Centro deportivo" ;
    rr:parent "NOMBRE" .

map:map_triplesmapSportsFacility_000 a rr:TriplesMap ;
    rdfs:label "triplesmapSportsFacility" ;
    rml:logicalSource map:source_000 ;
    rr:subjectMap map:s_000 .

map:om_017 a rr:ObjectMap ;
    rr:constant am:SportActivity ;
    rr:termType rr:IRI .

map:om_018 a rr:ObjectMap ;
    rml:reference "Actividad" ;
    rr:datatype xsd:string ;
    rr:termType rr:Literal .

map:om_021 a rr:ObjectMap ;
    rr:constant time:Interval ;
    rr:termType rr:IRI .

map:om_022 a rr:ObjectMap ;
    rml:reference "Hora inicial" ;
    rr:datatype xsd:time ;
    rr:termType rr:Literal .

map:om_023 a rr:ObjectMap ;
    rml:reference "Hora final" ;
    rr:datatype xsd:time ;
    rr:termType rr:Literal .

map:om_024 a rr:ObjectMap ;
    rr:constant am:SportsClass ;
    rr:termType rr:IRI .

map:om_025 a rr:ObjectMap ;
    rr:datatype xsd:string ;
    rr:template "{Actividad} - {Día de la semana} de {Hora inicial} a {Hora final}" ;
    rr:termType rr:Literal .

map:om_026 a rr:ObjectMap ;
    rml:reference "Plazas" ;
    rr:datatype xsd:nonNegativeInteger ;
    rr:termType rr:Literal .

map:om_027 a rr:ObjectMap ;
    rml:reference "Ocupadas" ;
    rr:datatype xsd:nonNegativeInteger ;
    rr:termType rr:Literal .

map:om_028 a rr:ObjectMap ;
    rml:reference "Libres" ;
    rr:datatype xsd:nonNegativeInteger ;
    rr:termType rr:Literal .

map:om_029 a rr:ObjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportActivity/{Actividad}" ;
    rr:termType rr:IRI .

map:om_030 a rr:ObjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/TimeInterval/{Hora inicial}-{Hora final}" ;
    rr:termType rr:IRI .

map:om_037 a rr:ObjectMap ;
    rr:joinCondition map:jc_000 ;
    rr:parentTriplesMap map:map_triplesmapSportsFacility_000 .

map:pm_017 a rr:PredicateMap ;
    rr:constant rdf:type .

map:pm_018 a rr:PredicateMap ;
    rr:constant schema1:name .

map:pm_021 a rr:PredicateMap ;
    rr:constant rdf:type .

map:pm_022 a rr:PredicateMap ;
    rr:constant time:hasBeginning .

map:pm_023 a rr:PredicateMap ;
    rr:constant time:hasEnd .

map:pm_024 a rr:PredicateMap ;
    rr:constant rdf:type .

map:pm_025 a rr:PredicateMap ;
    rr:constant schema1:name .

map:pm_026 a rr:PredicateMap ;
    rr:constant am:offeredPlaces .

map:pm_027 a rr:PredicateMap ;
    rr:constant am:occupiedPlaces .

map:pm_028 a rr:PredicateMap ;
    rr:constant am:availablePlaces .

map:pm_029 a rr:PredicateMap ;
    rr:constant am:hasActivity .

map:pm_030 a rr:PredicateMap ;
    rr:constant time:hasTime .

map:pm_031 a rr:PredicateMap ;
    rr:constant am:takesPlaceAt .

map:pom_017 a rr:PredicateObjectMap ;
    rr:objectMap map:om_017 ;
    rr:predicateMap map:pm_017 .

map:pom_018 a rr:PredicateObjectMap ;
    rr:objectMap map:om_018 ;
    rr:predicateMap map:pm_018 .

map:pom_021 a rr:PredicateObjectMap ;
    rr:objectMap map:om_021 ;
    rr:predicateMap map:pm_021 .

map:pom_022 a rr:PredicateObjectMap ;
    rr:objectMap map:om_022 ;
    rr:predicateMap map:pm_022 .

map:pom_023 a rr:PredicateObjectMap ;
    rr:objectMap map:om_023 ;
    rr:predicateMap map:pm_023 .

map:pom_024 a rr:PredicateObjectMap ;
    rr:objectMap map:om_024 ;
    rr:predicateMap map:pm_024 .

map:pom_025 a rr:PredicateObjectMap ;
    rr:objectMap map:om_025 ;
    rr:predicateMap map:pm_025 .

map:pom_026 a rr:PredicateObjectMap ;
    rr:objectMap map:om_026 ;
    rr:predicateMap map:pm_026 .

map:pom_027 a rr:PredicateObjectMap ;
    rr:objectMap map:om_027 ;
    rr:predicateMap map:pm_027 .

map:pom_028 a rr:PredicateObjectMap ;
    rr:objectMap map:om_028 ;
    rr:predicateMap map:pm_028 .

map:pom_029 a rr:PredicateObjectMap ;
    rr:objectMap map:om_029 ;
    rr:predicateMap map:pm_029 .

map:pom_030 a rr:PredicateObjectMap ;
    rr:objectMap map:om_030 ;
    rr:predicateMap map:pm_030 .

map:pom_031 a rr:PredicateObjectMap ;
    rr:objectMap map:om_037 ;
    rr:predicateMap map:pm_031 .

map:s_000 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportsFacility/{PK}" .

map:s_004 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportActivity/{Actividad}" .

map:s_006 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/TimeInterval/{Hora inicial}-{Hora final}" .

map:s_007 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportsClass/OPEN_{Centro deportivo}_{Fecha}_{Hora inicial}_{Actividad}" .

map:source_000 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "sports_centers_info-updated.csv" .

map:source_004 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "open_classes-updated.csv" .

map:source_006 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "open_classes-updated.csv" .

map:source_007 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "open_classes-updated.csv" .

