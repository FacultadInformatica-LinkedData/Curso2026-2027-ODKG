map:s_000 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/SportsFacility/{PK}" .

map:s_001 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/PostalAddress/{PK}" .

map:s_002 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/Neighborhood/{BARRIO}" .

map:s_003 a rr:SubjectMap ;
    rr:template "https://w3id.org/active-madrid/resource/District/{DISTRITO}" .

map:source_000 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
    rml:source "sports_centers_info-updated.csv" .

map:source_001 a rml:LogicalSource ;
    rml:referenceFormulation ql:CSV ;
